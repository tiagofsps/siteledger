# Copy this file to .env and adjust the values for the local environment.
# Never commit real credentials or a production SECRET_KEY.

DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: sqlite for local development, postgresql for production.
DJANGO_DB_ENGINE=sqlite
DB_NAME=partilha_louca
DB_USER=partilha_louca
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Upload limits in bytes and maximum number of files per request.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=10

# Production security settings default to secure values when DJANGO_DEBUG=False.
# Uncomment only to override them intentionally.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Enable only when a trusted reverse proxy is configured to set this header.
DJANGO_TRUST_X_FORWARDED_PROTO=False

# Placeholders for future external services. Leave empty until configured.
EXTERNAL_SERVICE_API_KEY=
